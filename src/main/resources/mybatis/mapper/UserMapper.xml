<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.rural_tutoring.mapper.UserMapper">

    <insert id="insertUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password_hash, created_at, account)
        VALUES (#{username}, #{passwordHash}, #{createdAt}, #{account})
    </insert>

    <delete id="deleteUser">
        DELETE FROM users WHERE id = #{id}
    </delete>

    <update id="updateUser">
        UPDATE users
        SET username = #{username},
        password_hash = #{passwordHash},
        role = #{role},
        created_at = #{createdAt}
        WHERE id = #{id}
    </update>

    <select id="selectUserById" resultType="com.example.rural_tutoring.entity.User">
        SELECT * FROM users WHERE id = #{id}
    </select>

    <select id="selectAllUsers" resultType="com.example.rural_tutoring.entity.User">
        SELECT * FROM users
    </select>

    <select id="selectUsersByPage" resultType="com.example.rural_tutoring.entity.User">
        SELECT * FROM user
        <where>
            <if test="username != null and username != ''">
                username LIKE CONCAT('%', #{username}, '%')
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countUsers" resultType="long">
        SELECT COUNT(*)
        FROM user
        <where>
            <if test="username != null and username != ''">
                username LIKE CONCAT('%', #{username}, '%')
            </if>
        </where>
    </select>
</mapper>