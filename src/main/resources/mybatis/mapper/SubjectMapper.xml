<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.rural_tutoring.mapper.SubjectMapper">
    <insert id="insertSubject" parameterType="com.example.rural_tutoring.entity.Subject" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO subject (subject_name, description)
        VALUES (#{subjectName}, #{description})
    </insert>
</mapper> 