<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.rural_tutoring.mapper.HomeworkAttachmentMapper">
    
    <resultMap id="BaseResultMap" type="com.example.rural_tutoring.entity.HomeworkAttachment">
        <id column="id" property="id"/>
        <result column="homework_id" property="homeworkId"/>
        <result column="original_filename" property="originalFilename"/>
        <result column="file_url" property="fileUrl"/>
        <result column="file_size" property="fileSize"/>
        <result column="file_type" property="fileType"/>
        <result column="upload_time" property="uploadTime"/>
        <result column="uploaded_by" property="uploadedBy"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, homework_id, original_filename, file_url, file_size, file_type, upload_time, uploaded_by
    </sql>

    <insert id="batchInsert" parameterType="java.util.List" useGeneratedKeys="true" keyProperty="attachments.id" keyColumn="id">
        INSERT INTO homework_attachment (
            homework_id, original_filename, file_url, file_size, file_type, upload_time, uploaded_by
        ) VALUES 
        <foreach collection="attachments" item="item" separator=",">
            (
                #{item.homeworkId}, #{item.originalFilename}, #{item.fileUrl}, 
                #{item.fileSize}, #{item.fileType}, #{item.uploadTime}, #{item.uploadedBy}
            )
        </foreach>
    </insert>

    <select id="findByHomeworkId" resultMap="BaseResultMap">
        SELECT 
        <include refid="Base_Column_List"/>
        FROM homework_attachment
        WHERE homework_id = #{homeworkId}
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT 
        <include refid="Base_Column_List"/>
        FROM homework_attachment
        WHERE id = #{id}
    </select>

    <delete id="deleteByHomeworkId">
        DELETE FROM homework_attachment
        WHERE homework_id = #{homeworkId}
    </delete>

    <delete id="deleteById">
        DELETE FROM homework_attachment
        WHERE id = #{id}
    </delete>
</mapper> 